# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Packaging / venv
.venv/
venv/
env/
.whl/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local generated artifacts (kept out of git; regenerated by scripts)
data/generated/
*.local.json
*.local.csv

# Secrets must never be committed
.env
*.key
*.pem
secrets/

# Host bridge audit log (local evidence, regenerated by running the bridge)
bridges/.live_audit.jsonl
bridges/_probe_audit.jsonl

# 飞书回读缓存与演示用例的嵌套残留（本地证据，不入库；需要时按 token 重新 fetch / 重跑门禁生成）
reports/feishu_*.json
reports/_cases/**/_cases/

# CTUP 凭据排除（V87-A / G10）：玉安记忆凭证注册表只存指针，任何快照都不许带上盘
credential_registry.json
holoaeon_memory/
*.bak_ctup_*


# 备份残件（V85 / HA-2）：.bak 一律不入库，历史备份移到仓外 _holoaeon_devtools/backups/
*.bak
*.bak_*
